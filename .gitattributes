.gitattributes export-ignore
.gitignore export-ignore

# Keep the bytes used by the contest material and runtime manifests stable.
/.dockerignore text eol=lf
/Dockerfile text eol=lf
/src/** text eol=lf
/agent/conversation.json text eol=lf
/agent/evidence/learning-conversation.full.json text eol=lf
/agent/evidence/units-26-50/*.json text eol=lf
/agent/evidence/units-26-50/results.md text eol=lf
/conversation.json text eol=lf
/agent/learning_prompt.md text eol=lf
/tests/check_optimization_resources.py text eol=lf
/tests/check_optimizations.py text eol=lf
/tests/prompt_oracle.cpp text eol=lf
/tests/run_learning_experiments.py text eol=lf
/tests/run_linux_resource_validation.py text eol=lf
/tests/run_prompt_verification.py text eol=lf

# All OceanBase code is auto-formatted using clang-format.
*.c filter=codeformat
*.cc filter=codeformat
*.cpp filter=codeformat
*.h filter=codeformat
*.hpp filter=codeformat
*.i filter=codeformat
*.ic filter=codeformat
*.js filter=codeformat
